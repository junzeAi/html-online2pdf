{
    "id": "lecture",
    "name": "讲义",
    "category": "教学",
    "description": "课程讲义模板，包含标题、章节结构、要点提示",
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>讲义</title>\n    <style>\n        body {\n            font-family: 'Microsoft YaHei', SimSun, sans-serif;\n            padding: 20px;\n            max-width: 800px;\n            margin: 0 auto;\n            line-height: 1.8;\n        }\n        .lecture-header {\n            border-bottom: 3px solid #2c5aa0;\n            padding-bottom: 15px;\n            margin-bottom: 25px;\n        }\n        .lecture-title {\n            font-size: 22px;\n            font-weight: bold;\n            color: #2c5aa0;\n            margin-bottom: 8px;\n        }\n        .lecture-meta {\n            font-size: 14px;\n            color: #666;\n            display: flex;\n            gap: 20px;\n        }\n        .chapter {\n            margin: 25px 0;\n        }\n        .chapter-title {\n            font-size: 18px;\n            font-weight: bold;\n            color: #2c5aa0;\n            border-left: 4px solid #2c5aa0;\n            padding-left: 10px;\n            margin-bottom: 15px;\n        }\n        .section {\n            margin: 15px 0;\n        }\n        .section-title {\n            font-size: 16px;\n            font-weight: bold;\n            color: #333;\n            margin-bottom: 10px;\n        }\n        .content-block {\n            margin: 10px 0;\n            padding: 10px 15px;\n            background: #f8f9fa;\n            border-radius: 4px;\n        }\n        .key-point {\n            background: #fff3cd;\n            border: 1px solid #ffc107;\n            padding: 10px 15px;\n            margin: 10px 0;\n            border-radius: 4px;\n        }\n        .key-point-title {\n            font-weight: bold;\n            color: #856404;\n            margin-bottom: 5px;\n        }\n        .example-box {\n            background: #e7f3ff;\n            border: 1px solid #2c5aa0;\n            padding: 15px;\n            margin: 15px 0;\n            border-radius: 4px;\n        }\n        .example-title {\n            font-weight: bold;\n            color: #2c5aa0;\n            margin-bottom: 10px;\n        }\n        .note-box {\n            background: #d4edda;\n            border: 1px solid #28a745;\n            padding: 10px 15px;\n            margin: 10px 0;\n            border-radius: 4px;\n        }\n        .note-title {\n            font-weight: bold;\n            color: #155724;\n        }\n        ul, ol {\n            margin-left: 20px;\n        }\n        li {\n            margin: 5px 0;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"lecture-header\">\n        <div class=\"lecture-title\">课程名称 - 第N讲</div>\n        <div class=\"lecture-meta\">\n            <span>授课教师：________</span>\n            <span>日期：________</span>\n            <span>课时：________</span>\n        </div>\n    </div>\n    \n    <div class=\"chapter\">\n        <div class=\"chapter-title\">一、本章概述</div>\n        <div class=\"section\">\n            <div class=\"section-title\">学习目标</div>\n            <div class=\"content-block\">\n                <ol>\n                    <li>了解________的基本概念</li>\n                    <li>掌握________的核心原理</li>\n                    <li>能够应用________解决实际问题</li>\n                </ol>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"chapter\">\n        <div class=\"chapter-title\">二、核心内容</div>\n        <div class=\"section\">\n            <div class=\"section-title\">2.1 概念定义</div>\n            <div class=\"content-block\">\n                <p>请在此填写概念定义和详细说明...</p>\n            </div>\n            <div class=\"key-point\">\n                <div class=\"key-point-title\">重点</div>\n                <p>请在此标注重点内容...</p>\n            </div>\n        </div>\n        <div class=\"section\">\n            <div class=\"section-title\">2.2 原理讲解</div>\n            <div class=\"content-block\">\n                <p>请在此填写原理讲解内容...</p>\n            </div>\n            <div class=\"example-box\">\n                <div class=\"example-title\">示例</div>\n                <p>请在此填写示例内容...</p>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"chapter\">\n        <div class=\"chapter-title\">三、扩展知识</div>\n        <div class=\"section\">\n            <div class=\"content-block\">\n                <p>请在此填写扩展内容...</p>\n            </div>\n            <div class=\"note-box\">\n                <div class=\"note-title\">注意</div>\n                <p>请在此填写注意事项...</p>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"chapter\">\n        <div class=\"chapter-title\">四、小结</div>\n        <div class=\"content-block\">\n            <p>请在此填写本讲小结...</p>\n        </div>\n    </div>\n</body>\n</html>"
}