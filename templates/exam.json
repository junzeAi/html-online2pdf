{
    "id": "exam",
    "name": "试卷",
    "category": "教学",
    "description": "标准考试试卷模板，包含标题、考生信息、题目区域",
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>试卷</title>\n    <style>\n        body {\n            font-family: 'Microsoft YaHei', SimSun, sans-serif;\n            padding: 20px;\n            max-width: 800px;\n            margin: 0 auto;\n            line-height: 1.8;\n        }\n        .exam-header {\n            text-align: center;\n            border-bottom: 2px solid #333;\n            padding-bottom: 15px;\n            margin-bottom: 20px;\n        }\n        .exam-title {\n            font-size: 24px;\n            font-weight: bold;\n            margin-bottom: 10px;\n        }\n        .exam-info {\n            display: flex;\n            justify-content: space-between;\n            font-size: 14px;\n            margin-top: 15px;\n        }\n        .exam-info-item {\n            display: flex;\n            gap: 5px;\n        }\n        .exam-info-label {\n            font-weight: bold;\n        }\n        .exam-info-value {\n            border-bottom: 1px solid #333;\n            min-width: 100px;\n        }\n        .section {\n            margin: 20px 0;\n        }\n        .section-title {\n            font-size: 16px;\n            font-weight: bold;\n            background: #f0f0f0;\n            padding: 5px 10px;\n            margin-bottom: 15px;\n        }\n        .question {\n            margin: 15px 0;\n            padding-left: 20px;\n        }\n        .question-number {\n            font-weight: bold;\n        }\n        .question-content {\n            margin: 5px 0;\n        }\n        .question-options {\n            margin-left: 20px;\n        }\n        .option {\n            margin: 5px 0;\n        }\n        .answer-area {\n            margin: 10px 0;\n            min-height: 50px;\n            border: 1px dashed #ccc;\n            padding: 10px;\n        }\n        .score-box {\n            display: inline-block;\n            border: 1px solid #333;\n            padding: 2px 8px;\n            margin-left: 10px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"exam-header\">\n        <div class=\"exam-title\">___________试卷</div>\n        <div class=\"exam-info\">\n            <div class=\"exam-info-item\">\n                <span class=\"exam-info-label\">姓名:</span>\n                <span class=\"exam-info-value\"></span>\n            </div>\n            <div class=\"exam-info-item\">\n                <span class=\"exam-info-label\">班级:</span>\n                <span class=\"exam-info-value\"></span>\n            </div>\n            <div class=\"exam-info-item\">\n                <span class=\"exam-info-label\">学号:</span>\n                <span class=\"exam-info-value\"></span>\n            </div>\n            <div class=\"exam-info-item\">\n                <span class=\"exam-info-label\">得分:</span>\n                <span class=\"exam-info-value\"></span>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"section\">\n        <div class=\"section-title\">一、选择题 <span class=\"score-box\">共20分</span></div>\n        <div class=\"question\">\n            <span class=\"question-number\">1.</span>\n            <span class=\"question-content\">请在此填写题目内容...</span>\n            <div class=\"question-options\">\n                <div class=\"option\">A. 选项A</div>\n                <div class=\"option\">B. 选项B</div>\n                <div class=\"option\">C. 选项C</div>\n                <div class=\"option\">D. 选项D</div>\n            </div>\n        </div>\n        <div class=\"question\">\n            <span class=\"question-number\">2.</span>\n            <span class=\"question-content\">请在此填写题目内容...</span>\n            <div class=\"question-options\">\n                <div class=\"option\">A. 选项A</div>\n                <div class=\"option\">B. 选项B</div>\n                <div class=\"option\">C. 选项C</div>\n                <div class=\"option\">D. 选项D</div>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"section\">\n        <div class=\"section-title\">二、填空题 <span class=\"score-box\">共20分</span></div>\n        <div class=\"question\">\n            <span class=\"question-number\">1.</span>\n            <span class=\"question-content\">请在此填写题目内容，空格处用____表示。</span>\n        </div>\n        <div class=\"question\">\n            <span class=\"question-number\">2.</span>\n            <span class=\"question-content\">请在此填写题目内容，空格处用____表示。</span>\n        </div>\n    </div>\n    \n    <div class=\"section\">\n        <div class=\"section-title\">三、简答题 <span class=\"score-box\">共30分</span></div>\n        <div class=\"question\">\n            <span class=\"question-number\">1.</span>\n            <span class=\"question-content\">请在此填写题目内容...</span>\n            <div class=\"answer-area\">答题区域</div>\n        </div>\n    </div>\n    \n    <div class=\"section\">\n        <div class=\"section-title\">四、综合题 <span class=\"score-box\">共30分</span></div>\n        <div class=\"question\">\n            <span class=\"question-number\">1.</span>\n            <span class=\"question-content\">请在此填写题目内容...</span>\n            <div class=\"answer-area\" style=\"min-height: 100px;\">答题区域</div>\n        </div>\n    </div>\n</body>\n</html>"
}