{
    "id": "summary",
    "name": "知识点总结",
    "category": "教学",
    "description": "知识点总结模板，包含分类整理、要点归纳、思维导图结构",
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>知识点总结</title>\n    <style>\n        body {\n            font-family: 'Microsoft YaHei', SimSun, sans-serif;\n            padding: 20px;\n            max-width: 900px;\n            margin: 0 auto;\n            line-height: 1.8;\n        }\n        .summary-header {\n            text-align: center;\n            border-bottom: 2px solid #e74c3c;\n            padding-bottom: 20px;\n            margin-bottom: 30px;\n        }\n        .summary-title {\n            font-size: 24px;\n            font-weight: bold;\n            color: #e74c3c;\n            margin-bottom: 10px;\n        }\n        .summary-subtitle {\n            font-size: 14px;\n            color: #666;\n        }\n        .knowledge-section {\n            margin: 25px 0;\n            border: 1px solid #ddd;\n            border-radius: 8px;\n            padding: 20px;\n            background: #fff;\n        }\n        .knowledge-title {\n            font-size: 18px;\n            font-weight: bold;\n            color: #e74c3c;\n            border-bottom: 2px solid #e74c3c;\n            padding-bottom: 8px;\n            margin-bottom: 15px;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n        .knowledge-title-number {\n            background: #e74c3c;\n            color: #fff;\n            padding: 2px 8px;\n            border-radius: 4px;\n            font-size: 14px;\n        }\n        .knowledge-item {\n            margin: 12px 0;\n            padding: 10px 15px;\n            background: #f5f5f5;\n            border-radius: 4px;\n        }\n        .knowledge-item-title {\n            font-weight: bold;\n            color: #333;\n            margin-bottom: 5px;\n        }\n        .knowledge-item-content {\n            color: #555;\n        }\n        .formula-box {\n            background: #fff8e1;\n            border: 1px solid #ffc107;\n            padding: 15px;\n            margin: 15px 0;\n            border-radius: 4px;\n            text-align: center;\n            font-size: 16px;\n        }\n        .formula-title {\n            font-weight: bold;\n            color: #856404;\n            margin-bottom: 8px;\n            text-align: left;\n        }\n        .compare-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin: 15px 0;\n        }\n        .compare-table th,\n        .compare-table td {\n            border: 1px solid #ddd;\n            padding: 10px;\n            text-align: left;\n        }\n        .compare-table th {\n            background: #e74c3c;\n            color: #fff;\n        }\n        .compare-table tr:nth-child(even) {\n            background: #f9f9f9;\n        }\n        .tips-box {\n            background: #e8f5e9;\n            border: 1px solid #4caf50;\n            padding: 15px;\n            margin: 15px 0;\n            border-radius: 4px;\n        }\n        .tips-title {\n            font-weight: bold;\n            color: #2e7d32;\n            margin-bottom: 8px;\n        }\n        .mindmap-item {\n            display: flex;\n            align-items: flex-start;\n            margin: 10px 0;\n        }\n        .mindmap-bullet {\n            width: 20px;\n            height: 20px;\n            background: #e74c3c;\n            color: #fff;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 12px;\n            margin-right: 10px;\n            flex-shrink: 0;\n        }\n        .mindmap-content {\n            flex: 1;\n        }\n        .mindmap-subitem {\n            margin-left: 30px;\n            padding-left: 15px;\n            border-left: 2px solid #ddd;\n            margin-top: 8px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"summary-header\">\n        <div class=\"summary-title\">________知识点总结</div>\n        <div class=\"summary-subtitle">________章节 | ________学科</div>\n    </div>\n    \n    <div class=\"knowledge-section\">\n        <div class=\"knowledge-title\">\n            <span class=\"knowledge-title-number\">01</span>\n            基本概念\n        </div>\n        <div class=\"knowledge-item\">\n            <div class=\"knowledge-item-title\">概念一</div>\n            <div class=\"knowledge-item-content\">请在此填写概念定义和解释...</div>\n        </div>\n        <div class=\"knowledge-item\">\n            <div class=\"knowledge-item-title\">概念二</div>\n            <div class=\"knowledge-item-content\">请在此填写概念定义和解释...</div>\n        </div>\n    </div>\n    \n    <div class=\"knowledge-section\">\n        <div class=\"knowledge-title\">\n            <span class=\"knowledge-title-number\">02</span>\n            核心公式\n        </div>\n        <div class=\"formula-box\">\n            <div class=\"formula-title\">公式一：</div>\n            <p><strong>公式内容（如：a² + b² = c²）</strong></p>\n        </div>\n        <div class=\"formula-box\">\n            <div class=\"formula-title\">公式二：</div>\n            <p><strong>公式内容</strong></p>\n        </div>\n        <div class=\"tips-box\">\n            <div class=\"tips-title\">记忆技巧</div>\n            <p>请在此填写公式记忆技巧...</p>\n        </div>\n    </div>\n    \n    <div class=\"knowledge-section\">\n        <div class=\"knowledge-title\">\n            <span class=\"knowledge-title-number\">03</span>\n            对比辨析\n        </div>\n        <table class=\"compare-table\">\n            <tr>\n                <th>对比项</th>\n                <th>概念A</th>\n                <th>概念B</th>\n            </tr>\n            <tr>\n                <td>定义</td>\n                <td>请填写...</td>\n                <td>请填写...</td>\n            </tr>\n            <tr>\n                <td>特点</td>\n                <td>请填写...</td>\n                <td>请填写...</td>\n            </tr>\n            <tr>\n                <td>应用</td>\n                <td>请填写...</td>\n                <td>请填写...</td>\n            </tr>\n        </table>\n    </div>\n    \n    <div class=\"knowledge-section\">\n        <div class=\"knowledge-title\">\n            <span class=\"knowledge-title-number\">04</span>\n            知识脉络\n        </div>\n        <div class=\"mindmap-item\">\n            <div class=\"mindmap-bullet">1</div>\n            <div class=\"mindmap-content\">\n                <strong>核心知识点一</strong>\n                <div class=\"mindmap-subitem\">\n                    <div>• 子知识点a</div>\n                    <div>• 子知识点b</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mindmap-item\">\n            <div class=\"mindmap-bullet">2</div>\n            <div class=\"mindmap-content\">\n                <strong>核心知识点二</strong>\n                <div class=\"mindmap-subitem\">\n                    <div>• 子知识点a</div>\n                    <div>• 子知识点b</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</body>\n</html>"
}